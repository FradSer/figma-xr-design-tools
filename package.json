{
  "dependencies": {
    "@create-figma-plugin/ui": "^4.0.1",
    "@create-figma-plugin/utilities": "^4.0.1",
    "preact": "^10"
  },
  "devDependencies": {
    "@create-figma-plugin/build": "^4.0.1",
    "@create-figma-plugin/tsconfig": "^4.0.1",
    "@figma/plugin-typings": "1.51.0",
    "@types/jest": "^29.5.1",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "8.23.1",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-react": "7.31.8",
    "jest": "^29.5.0",
    "prettier": "2.7.1",
    "ts-jest": "^29.1.0",
    "typescript": "^5"
  },
  "scripts": {
    "build": "build-figma-plugin --typecheck --minify",
    "watch": "build-figma-plugin --typecheck --watch",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "jest"
  },
  "figma-plugin": {
    "editorType": [
      "figma"
    ],
    "id": "1149634536150338038",
    "name": "XR Design Tools",
    "documentAccess": "dynamic-page",
    "networkAccess": {
      "allowedDomains": ["none"]
    },
    "menu": [
      {
        "name": "FOV Guide Generator",
        "main": "src/fov-guide-generator/main.ts",
        "ui": "src/fov-guide-generator/ui.tsx"
      },
      {
        "name": "FOV Calculator",
        "main": "src/fov-calculator/main.ts",
        "ui": "src/fov-calculator/ui.tsx"
      }
    ]
  },
  "prettier": {
    "parser": "typescript",
    "tabWidth": 2,
    "singleQuote": true,
    "printWidth": 80,
    "semi": false
  }
}
